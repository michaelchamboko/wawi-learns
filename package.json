{
  "name": "wawi-learns",
  "version": "0.0.0-local",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -p none \"serwist build --watch\" \"next dev\"",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit tests/**/*.unit.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:content": "vitest run tests/content",
    "test:offline": "playwright test tests/e2e/onboarding",
    "test:security": "vitest run tests/security",
    "build:packs": "tsx scripts/content/build-packs.ts",
    "verify:pack": "tsx scripts/content/verify-pack.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@oslojs/crypto": "^1.0.1",
    "@serwist/next": "9.5.12",
    "convex": "1.43.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@serwist/window": "9.5.12",
    "@types/node": "24.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "9.0.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "4.9.0",
    "playwright": "1.62.1",
    "serwist": "9.5.12",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
